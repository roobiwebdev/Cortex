{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cortex",
  "version": "0.1.0",
  "identifier": "dev.roobi.cortex",
  "build": {
    "devUrl": "http://localhost:3002",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: mediastream: cortex-media:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "freezePrototype": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Cortex",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 18 }
      },
      {
        "label": "settings",
        "create": false,
        "title": "Settings",
        "url": "index.html",
        "width": 860,
        "height": 620,
        "resizable": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 18 }
      },
      {
        "label": "onboarding",
        "create": false,
        "title": "Welcome to Cortex",
        "url": "index.html",
        "width": 880,
        "height": 560,
        "resizable": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 18 }
      },
      {
        "label": "trim",
        "create": false,
        "title": "Quick trim",
        "url": "index.html",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 18 }
      },
      {
        "label": "menubar",
        "create": false,
        "acceptFirstMouse": true,
        "title": "Cortex",
        "url": "index.html",
        "width": 340,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "hud",
        "create": false,
        "acceptFirstMouse": true,
        "title": "Cortex HUD",
        "url": "index.html",
        "width": 560,
        "height": 120,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "toasts",
        "create": false,
        "acceptFirstMouse": true,
        "title": "Cortex notifications",
        "url": "index.html",
        "width": 380,
        "height": 360,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "countdown",
        "create": false,
        "title": "Cortex countdown",
        "url": "index.html",
        "width": 320,
        "height": 320,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "region",
        "create": false,
        "title": "Cortex region picker",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Video",
    "shortDescription": "Screen, camera and audio recorder",
    "copyright": "MIT OR Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "Cortex Dev Signing",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQjVCQjZBQ0JGMzdEQzUKUldURmZmUExhcnUxazhzdThad1dSalF6eVgxTVFud1FwbnZhMUVidG9SbFIxeEd0OWFRSGJDOWQK",
      "endpoints": ["https://cortex.example/updates/latest.json"],
      "requireSignedVersion": true
    }
  }
}
