{
  "name": "site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 3010",
    "build": "vite build",
    "preview": "vite preview --port 3010",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "og": "sh scripts/og/render.sh"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "catalog:",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.17"
  }
}
